generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  passwordHash String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  profile      UserProfile?
  foodLogs     FoodLog[]
  mealPlans    MealPlan[]
}

model UserProfile {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @unique @db.Uuid
  age                 Int?
  gender              String?
  height              Decimal? @db.Decimal(6, 2)
  weight              Decimal? @db.Decimal(6, 2)
  activityLevel       String?
  fitnessGoal         String?
  dietPreference      String?
  allergies           String[] @default([])
  dietaryRestrictions String[] @default([])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Food {
  id           String         @id @default(uuid()) @db.Uuid
  name         String         @unique
  category     String
  servingSize  Decimal        @db.Decimal(8, 2)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  nutrition    FoodNutrition?
  foodLogs     FoodLog[]
}

model FoodNutrition {
  id            String   @id @default(uuid()) @db.Uuid
  foodId        String   @unique @db.Uuid
  calories      Decimal  @db.Decimal(10, 2)
  protein       Decimal  @db.Decimal(10, 2)
  carbohydrates Decimal  @db.Decimal(10, 2)
  fat           Decimal  @db.Decimal(10, 2)
  fiber         Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  food          Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)
}

model FoodLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  foodId     String   @db.Uuid
  mealType   MealType
  servings   Decimal  @db.Decimal(8, 2)
  consumedAt DateTime
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  food       Food     @relation(fields: [foodId], references: [id], onDelete: Restrict)

  @@index([userId, consumedAt])
  @@index([foodId])
}

model Meal {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  description   String?
  mealType      MealType
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  mealPlanItems MealPlanItem[]

  @@index([mealType])
}

model MealPlan {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @db.Uuid
  name      String
  startDate DateTime       @db.Date
  endDate   DateTime       @db.Date
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     MealPlanItem[]

  @@index([userId, startDate])
}

model MealPlanItem {
  id         String   @id @default(uuid()) @db.Uuid
  mealPlanId String   @db.Uuid
  mealId     String   @db.Uuid
  date       DateTime @db.Date
  mealType   MealType
  servings   Decimal  @db.Decimal(8, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  meal       Meal     @relation(fields: [mealId], references: [id], onDelete: Restrict)

  @@index([mealPlanId, date])
  @@index([mealId])
}
